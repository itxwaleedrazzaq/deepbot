<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="test">


  <gazebo reference='base_link'><material>Gazebo/Blue</material></gazebo>

  <gazebo reference='mid_front_rotary'>
  <material>Gazebo/White</material></gazebo>
  <gazebo reference='front_axle'><material>Gazebo/Green</material></gazebo>

  <gazebo reference='front_right_wheel'>
    <material>Gazebo/Black</material>
    <mu1 value='0.1'/>
    <mu2 value='0.1'/>
  </gazebo>
  <gazebo reference='front_left_wheel'>
    <material>Gazebo/Black</material>
      <mu1 value='0.1'/>
      <mu2 value='0.1'/>
  </gazebo>

  <gazebo reference='mid_back_rotary'><material>Gazebo/White</material></gazebo>
  <gazebo reference='back_axle'><material>Gazebo/Green</material></gazebo>
  
  <gazebo reference='back_right_wheel'>
    <material>Gazebo/Black</material>
    <mu1 value='0.1'/>
    <mu2 value='0.1'/>
  </gazebo>
  <gazebo reference='back_left_wheel'>
    <material>Gazebo/Black</material>
    <mu1 value='0.1'/>
    <mu2 value='0.1'/>
  </gazebo>
  <gazebo reference='camera_link'><material>Gazebo/Yellow</material></gazebo>


    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="front_axle_left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="back_axle_left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="front_axle_right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="back_axle_right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>



    <gazebo>
        <plugin
            filename="libgazebo_ros2_control.so"
            name="gazebo_ros2_control">

            <ros>
                <remapping>/diff_cont/cmd_vel_unstamped:=cmd_vel</remapping>
                <remapping>/diff_cont/odom:=odom</remapping>
            </ros>

            <parameters>
                $(find deepbot_bringup)/config/diffdrive_params.yaml
            </parameters>
        </plugin>
    </gazebo>


</robot>