<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nacbot">


    <xacro:property name='base_length' value='1.0'/>
    <xacro:property name='base_width' value='${base_length/3.0}'/>
    <xacro:property name='base_height' value='${base_length/15.0}'/>
    <xacro:property name='base_mass' value='0.1'/>


    <xacro:property name='axle_length' value='${base_length/2.0}'/>
    <xacro:property name='axle_radius' value='${base_width/15.0}'/>
    <xacro:property name='axle_mass' value='${base_mass/5.0}'/>


    <xacro:property name='rotary_length' value='${axle_radius/2.0}'/>
    <xacro:property name='rotary_radius' value='${axle_radius}'/>
    <xacro:property name='rotary_mass' value='${base_mass/5.0}'/>


    <xacro:property name='wheel_length' value='${axle_radius}'/>
    <xacro:property name='wheel_radius' value='${axle_radius*4.0}'/>
    <xacro:property name='wheel_mass' value='${base_mass/10.0}'/>

    <xacro:property name='camera_mass' value='${base_mass/50.0}'/>
    
    <xacro:property name='correction' value='2.0'/>



    <material name="blue">  <color rgba="0.1 0.3 0.9 1.0"/> </material>   <!-- royal blue -->
    <material name="green"> <color rgba="0.6 1.0 0.1 1.0"/> </material>   <!-- lime / acid green -->
    <material name="white"> <color rgba="1.0 1.0 1.0 1.0"/> </material>   <!-- pure white -->
    <material name="black"> <color rgba="0.1 0.1 0.1 1.0"/> </material>   <!-- charcoal -->



    <xacro:include filename='intertial_macros.urdf.xacro'/>    <!-- intertial-marcos -->
    <xacro:include filename='body_macros.urdf.xacro'/>         <!-- body-marcos -->
    <xacro:include filename='nacbot.urdf.xacro'/>              <!-- nacbot-chassis -->
    <xacro:include filename='camera.urdf.xacro'/>              <!-- adding camera -->


    <xacro:include filename="gazebo_ros2_control.urdf.xacro" /> 


</robot>
